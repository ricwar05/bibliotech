<mxfile host="app.diagrams.net"><diagram name="flow-books" id="flow-books"><mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n_s" value="Inicio: guardar libro" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="175" y="20" width="150" height="54" as="geometry"/></mxCell><mxCell id="n_d1" value="¿Año y ejemplares son números?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="130" y="119" width="240" height="120" as="geometry"/></mxCell><mxCell id="n_e1" value="“El año debe ser un número entero” / “Los ejemplares deben ser un número entero”" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="26" y="437" width="320" height="76" as="geometry"/></mxCell><mxCell id="n_d2" value="¿ISBN de 10 o 13 dígitos (sin contar guiones)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="277" y="295" width="240" height="120" as="geometry"/></mxCell><mxCell id="n_e2" value="“El ISBN debe tener 10 o 13 dígitos.”" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="218" y="677" width="320" height="76" as="geometry"/></mxCell><mxCell id="n_d3" value="¿Título vacío o de más de 200? ¿Autor vacío o de más de 150?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="469" y="535" width="240" height="120" as="geometry"/></mxCell><mxCell i