<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="10.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pa.bibliotech.ui.LoginController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label text="Iniciar Sesión - BiblioTech" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
        <TextField fx:id="usernameField" promptText="Usuario" />
        <PasswordField fx:id="passwordField" promptText="Contraseña" />
        <Button text="Ingresar" onAction="#handleLogin" />
    </children>
</VBox>