<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="15.0" prefWidth="420.0" prefHeight="380.0"
      xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pa.bibliotech.ui.MainMenuController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
    <children>
        <Label text="Menú Principal - BiblioTech" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
        <Label fx:id="welcomeLabel" />
        <Button text="Gestión de Libros" onAction="#handleOpenBooks" prefWidth="220.0" />
        <Button text="Gestión de Socios" onAction="#handleOpenMembers" prefWidth="220.0" />
        <Button fx:id="usersButton" text="Usuarios (solo administrador)" onAction="#handleUsers" prefWidth="220.0" />
        <Button text="Cerrar sesión" onAction="#handleLogout" prefWidth="220.0" />
    </children>
</VBox>
